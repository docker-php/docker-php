{
  "name": "docker-php-documentation",
  "private": true,
  "description": "Local preview and checks for the Docker PHP Mintlify documentation",
  "engines": {
    "node": ">=20.17 <25"
  },
  "scripts": {
    "dev": "mint dev --no-open --telemetry false",
    "validate": "mint validate --telemetry false",
    "check:links": "mint broken-links --check-anchors --telemetry false",
    "check:examples": "php scripts/check-php-examples.php"
  },
  "devDependencies": {
    "mint": "4.2.992"
  },
  "overrides": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "adm-zip": "^0.6.1",
    "axios": "^1.20.0",
    "fflate": "^0.8.3",
    "js-yaml@^4": "^4.3.2",
    "katex": "^0.18.2",
    "postcss-selector-parser": "^7.1.6",
    "qs": "^6.16.0",
    "sharp": "^0.35.5"
  }
}
